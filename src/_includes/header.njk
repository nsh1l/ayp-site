<header class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
    <a href="/" class="flex items-center gap-3" aria-label="AYP Home">
      <img src="/assets/ayp_logo_square_nuttsponchon-3.jpg" alt="AYP ロゴ" class="h-10 w-10 rounded-xl object-cover" loading="eager" />
      <div>
        <div class="text-sm font-semibold tracking-wide text-navy">Always Yesterday Party</div>
        <div class="text-xs text-grayish">Corporate Site</div>
      </div>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
      {% for item in site.nav %}
        <a class="text-sm font-medium text-slate-700 hover:text-navy" href="{{ item.url }}">{{ item.label }}</a>
      {% endfor %}
    </nav>

    <a href="/contact/" class="inline-flex items-center justify-center rounded-full bg-orange px-4 py-2 text-sm font-semibold text-white shadow-soft hover:opacity-95">
      相談する
    </a>
  </div>

  <div class="mx-auto max-w-6xl px-4 pb-3 md:hidden">
    <nav class="flex flex-wrap gap-3" aria-label="Primary">
      {% for item in site.nav %}
        <a class="rounded-full border border-slate-200 px-4 py-2 text-sm" href="{{ item.url }}">{{ item.label }}</a>
      {% endfor %}
    </nav>
  </div>
</header>
