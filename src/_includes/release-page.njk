{% set release = discography.releases | selectattr("release_page", "equalto", page.url) | first %}
<main>
  <section class="bg-navy text-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 sm:py-20 md:grid-cols-[minmax(0,1fr)_24rem] md:items-end">
      <div>
        <a href="/#discography" class="text-sm font-semibold text-slate-300 hover:text-orange">← Discography</a>
        <p class="mt-10 text-xs font-semibold tracking-widest text-orange">RELEASE</p>
        <h1 class="mt-4 text-5xl font-bold tracking-tight sm:text-7xl">{{ release.title }}</h1>
        {% if release.date %}<time datetime="{{ release.date }}" class="mt-5 block text-sm text-slate-300">{{ release.date }}</time>{% endif %}
      </div>
      {% if release.image %}
        <img src="{{ release.image }}" alt="{{ release.title }} artwork" class="aspect-square w-full rounded-2xl object-cover shadow-soft" />
      {% else %}
        <div class="flex aspect-square items-center justify-center rounded-2xl bg-gradient-to-br from-slate-700 to-slate-900 p-8 text-center text-3xl font-bold text-slate-300 shadow-soft">{{ release.title }}</div>
      {% endif %}
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <p class="max-w-2xl text-lg leading-relaxed text-slate-600">{{ release.title }} は、Always Yesterday PartyからリリースされたSo1lohの作品です。</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {% if release.bandcamp %}<a href="{{ release.bandcamp }}" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-navy px-5 py-3 text-sm font-semibold text-white hover:bg-orange">Bandcamp ↗</a>{% endif %}
        {% if release.spotify %}<a href="{{ release.spotify }}" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-navy hover:border-orange hover:text-orange">Spotify ↗</a>{% endif %}
        {% if release.apple_music %}<a href="{{ release.apple_music }}" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-navy hover:border-orange hover:text-orange">Apple Music ↗</a>{% endif %}
        {% if release.youtube_music %}<a href="{{ release.youtube_music }}" target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full border border-slate-300 px-5 py-3 text-sm font-semibold text-navy hover:border-orange hover:text-orange">YouTube Music ↗</a>{% endif %}
      </div>
      {% if release.void_series %}
        <div class="mt-12 rounded-2xl bg-slate-50 p-7">
          <p class="text-xs font-semibold tracking-widest text-orange">VOID SERIES</p>
          <p class="mt-3 text-slate-600">シリーズのアーカイブと関連コンテンツは、voidシリーズサイトで公開しています。</p>
          <a href="{{ release.void_series }}" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex text-sm font-semibold text-navy underline decoration-orange decoration-2 underline-offset-4 hover:text-orange">void.alwaysyesterday.party ↗</a>
        </div>
      {% endif %}
    </div>
  </section>
</main>
