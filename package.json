{
  "name": "ayp-site",
  "private": true,
  "version": "1.0.0",
  "description": "Always Yesterday Party corporate static site",
  "scripts": {
    "fetch": "bun run scripts/fetch-bandcamp.mjs",
    "build": "bun run fetch && eleventy --config .eleventy.cjs",
    "serve": "eleventy --serve --config .eleventy.cjs"
  },
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "@11ty/eleventy": "^3.1.6"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
